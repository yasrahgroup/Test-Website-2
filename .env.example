# PostgreSQL Database Configuration
# Optional: a separate test database for npm test / test:startup / test:parity.
# Tests create and remove a uniquely named schema in this database. Never point it at production.
# TEST_DATABASE_URL=postgresql://user:password@host:port/test_database?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_URL_UNPOOLED=postgresql://user:password@host:port/database

# Admin Credentials
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=your-secure-password-here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password-here

# Server Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECRET=your-random-cookie-secret-here

# Email Notifications (Optional - Brevo SMTP)
EMAIL_FROM=hello@yourdomain.com
SUPPORT_EMAIL=hello@yourdomain.com
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-api-key

# Alternative: Resend API (if preferred over SMTP)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# NOTIFY_FROM=noreply@yourdomain.com
# NOTIFY_TO=hello@yourdomain.com

# Storage Configuration
STORAGE_DIR=./storage
# Without these settings, forms still save to CMS but no emails are sent.